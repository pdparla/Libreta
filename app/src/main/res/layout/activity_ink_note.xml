<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.parla.libreta.ui.ink.InkView
        android:id="@+id/ink_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Tools, history and pages -->
    <LinearLayout
        style="@style/InkToolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <ImageButton
            android:id="@+id/ink_pen"
            style="@style/InkTool"
            android:contentDescription="@string/ink_pen"
            android:src="@drawable/ic_ink_pen" />

        <ImageButton
            android:id="@+id/ink_eraser"
            style="@style/InkTool"
            android:contentDescription="@string/ink_eraser"
            android:src="@drawable/ic_ink_eraser" />

        <ImageButton
            android:id="@+id/ink_select"
            style="@style/InkTool"
            android:contentDescription="@string/ink_select"
            android:src="@drawable/ic_ink_select" />

        <ImageButton
            android:id="@+id/ink_undo"
            style="@style/InkTool"
            android:contentDescription="@string/ink_undo"
            android:src="@drawable/ic_ink_undo" />

        <ImageButton
            android:id="@+id/ink_redo"
            style="@style/InkTool"
            android:contentDescription="@string/ink_redo"
            android:src="@drawable/ic_ink_redo" />

        <ImageButton
            android:id="@+id/ink_dictate"
            style="@style/InkTool"
            android:contentDescription="@string/action_dictate"
            android:src="@drawable/ic_mic" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/ink_prev"
            style="@style/InkTool"
            android:contentDescription="@string/ink_prev"
            android:src="@drawable/ic_ink_prev" />

        <TextView
            android:id="@+id/ink_page"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="48dp"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <ImageButton
            android:id="@+id/ink_next"
            style="@style/InkTool"
            android:contentDescription="@string/ink_next"
            android:src="@drawable/ic_ink_next" />

        <ImageButton
            android:id="@+id/ink_add_page"
            style="@style/InkTool"
            android:contentDescription="@string/ink_add_page"
            android:src="@drawable/ic_ink_add_page" />
    </LinearLayout>

    <!-- Options of the selected tool: pen colour and width, eraser mode and size, or the AI actions on a selection -->
    <FrameLayout
        style="@style/InkToolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <LinearLayout
            android:id="@+id/ink_pen_options"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/ink_color"
                style="@style/InkSwatch"
                android:contentDescription="@string/ink_color" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/ink_width_thin"
                style="@style/InkWidth"
                android:text="@string/ink_width_thin" />

            <TextView
                android:id="@+id/ink_width_medium"
                style="@style/InkWidth"
                android:text="@string/ink_width_medium" />

            <TextView
                android:id="@+id/ink_width_thick"
                style="@style/InkWidth"
                android:text="@string/ink_width_thick" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ink_eraser_options"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/ink_erase_area"
                style="@style/InkWidth"
                android:text="@string/ink_erase_area" />

            <TextView
                android:id="@+id/ink_erase_strokes"
                style="@style/InkWidth"
                android:text="@string/ink_erase_strokes" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/ink_eraser_small"
                style="@style/InkWidth"
                android:text="@string/ink_eraser_small" />

            <TextView
                android:id="@+id/ink_eraser_medium"
                style="@style/InkWidth"
                android:text="@string/ink_eraser_medium" />

            <TextView
                android:id="@+id/ink_eraser_large"
                style="@style/InkWidth"
                android:text="@string/ink_eraser_large" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ink_select_options"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/ink_select_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ink_select_hint"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/ink_convert"
                style="@style/InkWidth"
                android:text="@string/ink_convert" />

            <TextView
                android:id="@+id/ink_chat"
                style="@style/InkWidth"
                android:text="@string/ink_chat" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
