<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The page, with the zoom controls over its bottom-right corner (docs/design/ink.md) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.parla.libreta.ui.ink.InkView
            android:id="@+id/ink_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/zoom_background"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ink_zoom_out"
                style="@style/InkZoom"
                android:contentDescription="@string/ink_zoom_out"
                android:text="@string/ink_zoom_out_label" />

            <TextView
                android:id="@+id/ink_zoom_level"
                style="@style/InkZoom"
                android:contentDescription="@string/ink_zoom_reset"
                android:minWidth="48dp" />

            <TextView
                android:id="@+id/ink_zoom_in"
                style="@style/InkZoom"
                android:contentDescription="@string/ink_zoom_in"
                android:text="@string/ink_zoom_in_label" />
        </LinearLayout>
    </FrameLayout>

    <!-- Tools, history and pages -->
    <LinearLayout
        style="@style/InkToolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <ImageButton
            android:id="@+id/ink_pen"
            style="@style/InkTool"
            android:contentDescription="@string/ink_pen"
            android:src="@drawable/ic_ink_pen" />

        <ImageButton
            android:id="@+id/ink_eraser"
            style="@style/InkTool"
            android:contentDescription="@string/ink_eraser"
            android:src="@drawable/ic_ink_eraser" />

        <ImageButton
            android:id="@+id/ink_select"
            style="@style/InkTool"
            android:contentDescription="@string/ink_select"
            android:src="@drawable/ic_ink_select" />

        <ImageButton
            android:id="@+id/ink_fill"
            style="@style/InkTool"
            android:contentDescription="@string/ink_fill"
            android:src="@drawable/ic_ink_fill" />

        <ImageButton
            android:id="@+id/ink_undo"
            style="@style/InkTool"
            android:contentDescription="@string/ink_undo"
            android:src="@drawable/ic_ink_undo" />

        <ImageButton
            android:id="@+id/ink_redo"
            style="@style/InkTool"
            android:contentDescription="@string/ink_redo"
            android:src="@drawable/ic_ink_redo" />

        <ImageButton
            android:id="@+id/ink_dictate"
            style="@style/InkTool"
            android:contentDescription="@string/action_dictate"
            android:src="@drawable/ic_mic" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/ink_prev"
            style="@style/InkTool"
            android:contentDescription="@string/ink_prev"
            android:src="@drawable/ic_ink_prev" />

        <TextView
            android:id="@+id/ink_page"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="48dp"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <ImageButton
            android:id="@+id/ink_next"
            style="@style/InkTool"
            android:contentDescription="@string/ink_next"
            android:src="@drawable/ic_ink_next" />

        <ImageButton
            android:id="@+id/ink_add_page"
            style="@style/InkTool"
            android:contentDescription="@string/ink_add_page"
            android:src="@drawable/ic_ink_add_page" />
    </LinearLayout>

    <!-- Options of the selected tool: pen colour and width, eraser mode and size, or the AI actions on a selection -->
    <FrameLayout
        style="@style/InkToolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <LinearLayout
            android:id="@+id/ink_pen_options"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/ink_color"
                style="@style/InkSwatch"
                android:contentDescription="@string/ink_color" />

            <!-- Pen thickness (docs/design/ink.md) -->
            <com.parla.libreta.ui.ink.SizePreview
                android:id="@+id/ink_pen_preview"
                style="@style/InkSizePreview" />

            <SeekBar
                android:id="@+id/ink_pen_size"
                style="@style/InkSizeBar"
                android:contentDescription="@string/ink_pen_size" />

            <TextView
                android:id="@+id/ink_pen_size_label"
                style="@style/InkSizeLabel" />
        </LinearLayout>

        <!-- The paint bucket (docs/design/ink.md): the pen's colour -->
        <LinearLayout
            android:id="@+id/ink_fill_options"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:id="@+id/ink_fill_color"
                style="@style/InkSwatch"
                android:contentDescription="@string/ink_color" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ink_fill_hint"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ink_eraser_options"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/ink_erase_area"
                style="@style/InkWidth"
                android:text="@string/ink_erase_area" />

            <TextView
                android:id="@+id/ink_erase_strokes"
                style="@style/InkWidth"
                android:text="@string/ink_erase_strokes" />

            <com.parla.libreta.ui.ink.SizePreview
                android:id="@+id/ink_eraser_preview"
                style="@style/InkSizePreview" />

            <SeekBar
                android:id="@+id/ink_eraser_size"
                style="@style/InkSizeBar"
                android:contentDescription="@string/ink_eraser_size" />

            <TextView
                android:id="@+id/ink_eraser_size_label"
                style="@style/InkSizeLabel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ink_select_options"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/ink_select_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ink_select_hint"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- On the selected strokes; hidden when the selection holds no ink -->
            <LinearLayout
                android:id="@+id/ink_selection_edit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:id="@+id/ink_selection_color"
                    style="@style/InkSwatch"
                    android:contentDescription="@string/ink_selection_color" />

                <ImageButton
                    android:id="@+id/ink_selection_width"
                    style="@style/InkTool"
                    android:contentDescription="@string/ink_selection_width"
                    android:src="@drawable/ic_ink_width" />

                <ImageButton
                    android:id="@+id/ink_selection_copy"
                    style="@style/InkTool"
                    android:contentDescription="@string/ink_selection_copy"
                    android:src="@drawable/ic_ink_copy" />

                <ImageButton
                    android:id="@+id/ink_selection_delete"
                    style="@style/InkTool"
                    android:contentDescription="@string/ink_selection_delete"
                    android:src="@drawable/ic_ink_delete" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/ink_paste"
                style="@style/InkTool"
                android:contentDescription="@string/ink_paste"
                android:src="@drawable/ic_ink_paste"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ink_convert"
                style="@style/InkWidth"
                android:text="@string/ink_convert" />

            <TextView
                android:id="@+id/ink_chat"
                style="@style/InkWidth"
                android:text="@string/ink_chat" />

            <TextView
                android:id="@+id/ink_math"
                style="@style/InkWidth"
                android:text="@string/ink_math" />

            <TextView
                android:id="@+id/ink_title"
                style="@style/InkWidth"
                android:text="@string/ink_title" />

            <TextView
                android:id="@+id/ink_tag"
                style="@style/InkWidth"
                android:text="@string/ink_tag" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
