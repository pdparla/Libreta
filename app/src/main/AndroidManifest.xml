<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dictation (docs/design/ai.md). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".LibretaApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.NoteListActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Single-app mode: Libreta as the home screen. Off by default; toggled from Ajustes (HomeMode). -->
        <activity-alias
            android:name=".ui.HomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".ui.NoteListActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Turns with the tablet without being recreated, so the note, undo and zoom stay (docs/design/ink.md). -->
        <activity
            android:name=".ui.ink.InkNoteActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".ui.NoteListActivity" />

        <activity
            android:name=".ui.NoteEditorActivity"
            android:exported="false"
            android:parentActivityName=".ui.NoteListActivity"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/action_settings"
            android:parentActivityName=".ui.NoteListActivity"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Conversation about a selection of a handwritten page; never recreated, so turning keeps the conversation. -->
        <activity
            android:name=".ui.ai.AiChatActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Started by scripts/chatgpt-login.sh and stt-pair.sh with am start, hence exported; it only reads what adb pushed. -->
        <activity
            android:name=".ui.AdbImportActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <service
            android:name=".sync.SyncService"
            android:exported="false" />
    </application>
</manifest>
